{
  // 线上：https://book.routex.one （Cloudflare Workers 静态站，2026-09-28 首次部署）
  // 更新：python3 build_site.py && npx wrangler deploy（需 CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID 环境变量）
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snowmoon-zh",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "site"
  },
  "routes": [{ "pattern": "book.routex.one", "custom_domain": true }]
}
